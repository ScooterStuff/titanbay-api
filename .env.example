# Copy to .env and adjust. Never commit a real .env.

# Postgres connection string. Required — the app crashes at boot if missing.
DATABASE_URL=postgres://titanbay:titanbay@localhost:5432/titanbay

# HTTP port the API listens on (default 3000).
PORT=3000

# node environment: development | test | production
NODE_ENV=development

# Optional: when set, the integration test suite connects to this Postgres
# instead of starting a Testcontainers instance. Useful in environments
# without Docker. Example: postgres://postgres:postgres@localhost:54330/postgres
# TEST_DATABASE_URL=
